@model List<EventMangementSystem.Models.Inventory>
@using EventMangementSystem.Models
@{
    ApplicationDbContext db = new ApplicationDbContext();
    var driverAssignment = ViewBag.DriverAssignment as EventMangementSystem.Models.DriverAssignment;
    var eventInventory = ViewBag.EventInventory as EventMangementSystem.Models.EventInventory;
}

<h2 class="page-title">Inspect Equipment</h2>

<form action="@Url.Action("SubmitReturnProcess", "DriverAssignments")" method="post">
    <input type="hidden" name="AssignmentId" value="@driverAssignment.AssDrivId" />

    <div class="card-container">
        @foreach (var item in Model)
        {
            <div class="card">
                <div class="card-header">
                    <img src="~/assets/images/@item.picture" class="item-picture" alt="@item.ItemName" />
                    <h4>@item.ItemName</h4>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label>Quantity Delivered</label>
                        <p>@eventInventory.QuantityRequired</p>
                        <input type="hidden" 
                               name="quantityDelivered[@eventInventory.EventInventoryId]" 
                               id="quantity-delivered-@eventInventory.EventInventoryId"
                               value="@eventInventory.QuantityRequired" />
                    </div>

                    <div class="form-group">
                        <label>Good Quantity Returned</label>
                        <input type="number" name="quantityReturned[@eventInventory.EventInventoryId]" id="quantity-returned-@eventInventory.EventInventoryId"
                               min="0" max="@eventInventory.QuantityRequired" required
                               value="0"
                               onchange="calculateRepairCost(@eventInventory.EventInventoryId, @item.ItemName)" />
                    </div>

                    <div class="form-group">
                        <label>Condition</label>
                        <select name="inspectionCondition[@eventInventory.EventInventoryId]" class="custom-dropdown" required>
                            <option value="Good">Good</option>
                            <option value="Intermediate">Intermediate</option>
                            <option value="Bad">Bad</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Repair Cost </label>
                        <input type="text" name="repairCost[@eventInventory.EventInventoryId]"
                               id="repair-cost-@eventInventory.EventInventoryId"
                               placeholder="Repair Cost" readonly 
                               value="0"/>
                    </div>

                    <div class="form-group">
                        <label>Inspection Notes</label>
                        <textarea name="inspectionNotes[@eventInventory.EventInventoryId]" class="form-control" rows="3" value=" " placeholder="Enter any notes here..."></textarea>
                    </div>

                    <!-- New field for Bill Status -->
                    <div class="form-group">
                        <label>Bill Status</label>
                        <select name="isBillSettled[@eventInventory.EventInventoryId]" class="custom-dropdown" required>
                            <option value="false">Not Paid</option>
                            <option value="true">Settled</option>
                        </select>
                    </div>

                    <!-- Hidden Fields to Pass Picture and Item Name -->
                    <input type="hidden" name="itemPicture[@eventInventory.EventInventoryId]" value="@item.picture" />
                    <input type="hidden" name="itemName[@eventInventory.EventInventoryId]" value="@item.ItemName" />
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Finish inspection</button>
</form>

<script>
    function calculateRepairCost(eventInventoryId, itemName) {
        var costPerItem = {
            "Chairs": 80,
            "Tables": 250,
            "Speakers": 500,
            "Microphones": 350
        };

        // Get delivered and returned quantities
        var deliveredQuantity = parseInt(document.getElementById('quantity-delivered-' + eventInventoryId).value);
        var returnedQuantity = parseInt(document.getElementById('quantity-returned-' + eventInventoryId).value);

        // Calculate the difference between delivered and returned quantities
        var difference = deliveredQuantity - returnedQuantity;

        // Get the cost per item based on itemName and calculate the total repair cost
        var repairCost = difference * (costPerItem[itemName] || 0);

        // Format the repair cost in Rands and update the input field
        document.getElementById('repair-cost-' + eventInventoryId).value = "R " + repairCost.toFixed(2);
    }</script>

<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 3rem;
        color: #343a40;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        width: 900px;
        margin-bottom: 20px;
        background-color: #fff;
    }

    .card-header {
        text-align: center;
        padding: 20px;
    }

        .card-header img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 50%;
            margin-bottom: 10px;
        }

        .card-header h4 {
            font-size: 1.5rem;
            margin: 0;
        }

    .card-body {
        padding: 20px;
    }

    .custom-dropdown {
        width: 100%;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #ccc;
        font-size: 1rem;
        background-color: white;
        color: #495057;
        appearance: none; /* Remove the default dropdown arrow */
        background-image: url('data:image/svg+xml;base64,...'); /* Custom dropdown arrow */
        background-position: right 10px center;
        background-repeat: no-repeat;
        background-size: 12px;
    }

        .custom-dropdown:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input[type="number"],
        .form-group input[type="text"] {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

    .btn {
        display: block;
        margin: 0 auto;
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
    }

        .btn:hover {
            background-color: #0056b3;
        }
</style>
