@model EventMangementSystem.Models.ServiceRequest
@using EventMangementSystem.Models
@{
    ApplicationDbContext db = new ApplicationDbContext();
    var bids = db.Quotations.Where(x => x.ServiceRequestId == Model.Id).ToList();
}

<div class="container">
    <h2>Available Bids for Service: <span class="text-primary">@Model.ServiceName</span></h2>

    <div class="row">
        @foreach (var bid in bids)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        @bid.ServiceProvider.Name
                    </div>
                    <div class="card-body">
                        <h3>@bid.Price.ToString("C") <small class="text-muted">/ service</small></h3>
                        <p><strong>Description:</strong> @bid.Description</p>
                        <p><strong>Service Provider Name:</strong> <span class="text-info">@bid.ServiceProvider.Name</span></p>
                        <p><strong>Service Provider Email:</strong> <span class="text-info">@bid.ServiceProvider.email</span></p>
                        <p><strong>Service Provider Number:</strong> <span class="text-info">@bid.ServiceProvider.ContactInfo</span></p>
                        @using (Html.BeginForm("SelectBid", "EventOrganizer", FormMethod.Post))
                        {
                            @Html.Hidden("requestId", Model.Id)
                            @Html.Hidden("bidId", bid.Id)
                            <button type="submit" class="btn-select-bid">
                                Select This Bid
                            </button>
                        }
                    </div>
                    @*<div class="card-footer">
                        <small>Bid submitted on @bid.CreatedDate.ToString("MMMM dd, yyyy")</small>
                    </div>*@
                </div>
            </div>
        }
    </div>
</div>
<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #f4f4f4;
    }

    .container {
        margin-top: 30px;
    }

    h2 {
        font-size: 2.5rem;
        color: #333;
        text-align: center;
        margin-bottom: 40px;
        font-family: 'Georgia', serif;
    }

    .card {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        padding: 20px;
        margin-bottom: 20px;
    }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

    .card-header {
        background-color: #007bff;
        color: #fff;
        padding: 15px;
        border-radius: 10px 10px 0 0;
        font-size: 1.5rem;
        font-weight: bold;
        text-align: center;
    }

    .card-body {
        padding: 15px;
    }

        .card-body h3 {
            font-size: 1.8rem;
            color: #28a745;
            margin-bottom: 10px;
        }

        .card-body p {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: #666;
        }

        .card-body .text-muted {
            font-style: italic;
        }

    .btn-select-bid {
        background-color: #28a745;
        color: #fff;
        padding: 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 1.1rem;
        width: 100%;
        transition: background-color 0.2s ease-in-out;
    }

        .btn-select-bid:hover {
            background-color: #218838;
        }

    .card-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: center;
        border-radius: 0 0 10px 10px;
        color: #999;
    }

    .text-info {
        color: #17a2b8;
    }
</style>
