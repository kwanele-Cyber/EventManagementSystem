@model EventMangementSystem.Models.Quotation

<h2>Reject Quotation</h2>

<p>Are you sure you want to reject this quotation?</p>

@using (Html.BeginForm("Reject", "Quotation", new { id = Model.QuotationId }, FormMethod.Post))
{
    <button type="submit" class="btn btn-danger">Yes, Reject</button>
    @Html.ActionLink("No, Cancel", "Index", new { serviceRequestId = Model.ServiceRequestId }, new { @class = "btn btn-secondary" })
}
