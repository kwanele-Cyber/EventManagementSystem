@model EventMangementSystem.Models.Quotation

@{
   
}

<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 2.5rem;
        color: #343a40;
    }
    /* Signature and form styling */
    .signature-pad {
        border: 1px solid #ddd;
        border-radius: 5px;
        width: 100%;
        height: 200px;
        background-color: #fff;
    }

    .clear-signature {
        margin-top: 10px;
        width: 100%;
    }

    .signature-section {
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .checklist-section {
        margin-bottom: 20px;
    }
</style>

<div class="container mt-5">
    <h2 class="page-title">Confirm Service for @Model.ServiceRequest.Event.Name</h2>

    <div class="card mt-4">
        <div class="card-header">
            Service: @Model.ServiceRequest.ServiceCategory
        </div>
        <div class="card-body">
            <p><strong>Bid Amount:</strong> @Model.Price.ToString("R.00")</p>
            <p><strong>Priority:</strong> @Model.ServiceRequest.Priority</p>

            @using (Html.BeginForm("ConfirmService", "ServiceProvider", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.Hidden("bidId", Model.Id)

                <!-- Checklist Section -->
            <div class="checklist-section">

            @{
                int index = 0;
            }
            @if (Model.ServiceRequest != null && Model.ServiceRequest.GroupTasks != null)
            {
                <h5>Tasks Performed</h5>
                
                foreach (var task in Model.ServiceRequest.GroupTasks)
                {
                    <div class="form-check">
                        @*<input class="form-check-input" type="checkbox" id="@task.TaskId" name="GroupTasks[@index]" required> *@
                        <label class="form-check-label" for="GroupTasks[@index]">Task @index: @task.TaskName Complete</label>
                    </div>

                    @*Increment the index of GroupTask At the end*@
                    index++;
                }
            }
            else if (Model.ServiceRequest != null && Model.ServiceRequest.Team != null && Model.ServiceRequest.Team.GroupTasks != null)
            {
                <h5>Tasks Performed</h5>
                
                foreach (var task in Model.ServiceRequest.Team.GroupTasks)
                {
                    <div class="form-check">
                        @*<input class="form-check-input" type="checkbox" id="@task.TaskId" name="GroupTasks[@index]" required> *@
                        <label class="form-check-label" for="GroupTasks[@index]">Task @index: @task.TaskName Complete</label>
                    </div>

                    @*Increment the index of GroupTask At the end*@
                    index++;
                }
            }
        </div>

                <!-- Signature Section for Event Manager -->
                <div class="signature-section">
                    <h5>Event Manager's Signature</h5>
                    <canvas class="signature-pad" id="eventManagerSignature"></canvas>
                    <input type="hidden" name="eventManagerSignatureData" id="eventManagerSignatureData" />
                    <button type="button" class="btn btn-secondary clear-signature" onclick="clearSignature('eventManagerSignaturePad')">Clear</button>
                </div>

                <!-- Signature Section for Service Provider -->
                <div class="signature-section">
                    <h5>Service Provider's Signature</h5>
                    <canvas class="signature-pad" id="serviceProviderSignature"></canvas>
                    <input type="hidden" name="serviceProviderSignatureData" id="serviceProviderSignatureData" />
                    <button type="button" class="btn btn-secondary clear-signature" onclick="clearSignature('serviceProviderSignaturePad')">Clear</button>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-success">Complete Service</button>
            }
        </div>
    </div>
</div>

<!-- Signature Pad Script -->
<script src="https://cdn.jsdelivr.net/npm/signature_pad@2.3.2/dist/signature_pad.min.js"></script>
<script>
    // Initialize Signature Pads
    var eventManagerPad = document.getElementById('eventManagerSignature');
    var serviceProviderPad = document.getElementById('serviceProviderSignature');

    // Adjust canvas for device pixel ratio
    function resizeCanvas(canvas) {
        var ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = canvas.offsetWidth * ratio;
        canvas.height = canvas.offsetHeight * ratio;
        canvas.getContext('2d').scale(ratio, ratio);
    }

    // Resize canvas and handle pixel ratio
    function initSignaturePad(canvasId) {
        var canvas = document.getElementById(canvasId);
        resizeCanvas(canvas); // Fix scaling for device pixel ratio
        return new SignaturePad(canvas);
    }

    var eventManagerSignaturePad = initSignaturePad('eventManagerSignature');
    var serviceProviderSignaturePad = initSignaturePad('serviceProviderSignature');

    // Clear signature pad function
    function clearSignature(padName) {
        if (padName === 'eventManagerSignaturePad') {
            eventManagerSignaturePad.clear();
        } else if (padName === 'serviceProviderSignaturePad') {
            serviceProviderSignaturePad.clear();
        }
    }

    // Capture Signatures before form submission
    $('form').submit(function (e) {
        if (eventManagerSignaturePad.isEmpty() || serviceProviderSignaturePad.isEmpty()) {
            alert('Both signatures are required before completing the service.');
            e.preventDefault();
            return;
        }

        // Save signature data as base64 image
        $('#eventManagerSignatureData').val(eventManagerSignaturePad.toDataURL());
        $('#serviceProviderSignatureData').val(serviceProviderSignaturePad.toDataURL());
    });

    // Ensure the canvas is resized properly when the window resizes
    window.addEventListener("resize", function () {
        resizeCanvas(eventManagerPad);
        resizeCanvas(serviceProviderPad);
    });
</script>
