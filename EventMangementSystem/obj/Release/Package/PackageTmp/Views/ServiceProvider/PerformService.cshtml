@model EventMangementSystem.ViewModels.PerformServiceViewModel

@{
    ViewBag.Title = "Perform Service";
}


<style>
    .table-striped {
        width: 100%;
        border-collapse: collapse;
    }

        .table-striped th, .table-striped td {
            padding: 10px;
            text-align: left;
        }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-warning {
        background-color: #ffc107;
        color: black;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }
</style>


<h2>Perform Service: @Model.ServiceRequest.ServiceName</h2>

<p>Status: @Model.ServiceRequest.Status</p>

@if (Model.Tasks != null && Model.Tasks.Any())
{
    <h3>Tasks</h3>
    <form method="post" action="@Url.Action("CompleteTask", "ServiceProvider")">
        <input name="serviceRequestId" value="@Model.ServiceRequest.Id" type="hidden" />
        <input name="returnUrl" value="@Model.ReturnUrl" type="hidden" />
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Task</th>
                    <th>Status</th>
                    <th>Complete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td>@task.TaskName</td>
                        <td>@task.Status</td>
                        <td>
                            @if (task.Status == EventMangementSystem.Models.GroupTaskStatus.Completed)
                            {
                                <span>Completed</span>
                            }
                            else
                            {
                                <input type="checkbox" name="taskId" value="@task.TaskId" onchange="this.form.submit()" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>

        if (Model.Tasks.All(t => t.Status == EventMangementSystem.Models.GroupTaskStatus.Completed))
        {
        <form method="post" action="@Url.Action("InspectServiceDelivery", "ServiceProvider")">
            <input name="serviceRequestId" value="@Model.ServiceRequest.Id" type="hidden" />
            <input name="returnUrl" value="@Model.ReturnUrl" type="hidden" />
            <input name="bidId" value="@Model.BidId" type="hidden" />
            <button type="submit" class="btn btn-success">Proceed To Service Delivery Inspection</button>
        </form>
    }
}
else
{
    <p>No tasks available for this service request.</p>
}