@model EventMangementSystem.Models.ServiceRequest
@{
    ViewBag.Title = "Service Request Details";
}

<h2>Service Request Details</h2>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Service Request Information</h3>
    </div>
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Id:</dt>
            <dd>@Model.Id</dd>

            <dt>Service Name:</dt>
            <dd>@Model.ServiceName</dd>

            <dt>Service Category:</dt>
            <dd>@Model.ServiceCategory</dd>

            <dt>Priority:</dt>
            <dd>@Model.Priority</dd>

            <dt>Status:</dt>
            <dd>@Model.Status</dd>

            <dt>Event:</dt>
            <dd>@Model.Event.Name</dd>

            <dt>Team:</dt>
            @if (Model.Team.TeamName != null)
            {
                <dd>@Model.Team.TeamName ?? "Not Assigned"</dd>
            }

            <dt>Service Provider:</dt>
            <dd>@Model.ServiceProvider?.Name ?? "Not Assigned"</dd>

            <dt>Is Completed:</dt>
            <dd>@Model.IsCompleted ? "Yes" : "No"</dd>

            <dt>Is Team Assigned:</dt>
            <dd>@Model.IsTeamAssigned ? "Yes" : "No"</dd>
        </dl>
    </div>
</div>

<!-- Actions like Edit, Delete -->
<p>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
</p>
