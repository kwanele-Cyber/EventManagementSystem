@model EventMangementSystem.Models.DamageReport

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center">Create Damage Report</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-lg p-4">
            <h4 class="mb-3">Damage Report Details</h4>
            <hr />

            <div class="form-group">
                @Html.LabelFor(model => model.DamageDescription, htmlAttributes: new { @class = "control-label" })
                <div>
                    @Html.DropDownListFor(model => model.DamageDescription,
                             new SelectList(Enum.GetValues(typeof(EventMangementSystem.Models.DamageType)).Cast<EventMangementSystem.Models.DamageType>().Select(d => new
                             {
                                 Value = d.ToString(),
                                 Text = d.ToString()
                             }), "Value", "Text"),
                             "Select Damage Type",
                             new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.DamageDescription, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Number of Damaged Items", htmlAttributes: new { @class = "control-label" })
                <div>
                    <input type="number" id="damagedItemsCount" name="damagedItemsCount" class="form-control" min="0" required />
                    <span class="text-danger" id="damagedItemsCountError" style="display:none;">Please include the correct number of damaged or missing items.</span>
                </div>
            </div>

            <div class="form-group text-center">
                <input type="submit" value="Create Report" class="btn btn-primary btn-lg" />
            </div>
        </div>
    }

    <div class="text-center mt-4">
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('damagedItemsCount').addEventListener('input', function () {
            const errorSpan = document.getElementById('damagedItemsCountError');
            errorSpan.style.display = this.value < 0 ? 'block' : 'none';
        });
    </script>
}