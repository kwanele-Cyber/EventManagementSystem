@model IEnumerable<EventMangementSystem.Models.Quotation>
@using EventMangementSystem.Models
@{
    ApplicationDbContext db = new ApplicationDbContext();
   
}

<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 3rem;
        color: #343a40;
    }

    /* General container styling */
    .container2 {
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Add shadow for card effect */
        margin-top: 20px;
    }

    /* Heading styling */
    h2 {
        color: #333;
        font-weight: bold;
        margin-bottom: 20px;
        text-align: center;
        font-family: 'Arial', sans-serif;
    }

    /* Table styling */
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        font-size: 16px;
        font-family: 'Arial', sans-serif;
    }

        .table thead th {
            background-color: #007bff;
            color: white;
            text-align: left;
            padding: 10px;
        }

        .table tbody td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        /* Add hover effect for table rows */
        .table tbody tr:hover {
            background-color: #f1f1f1;
        }

    /* Confirm button styling */
    .confirm-btn {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 10px 15px;
        text-align: center;
        text-decoration: none;
        font-size: 14px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        /* Button hover effect */
        .confirm-btn:hover {
            background-color: #218838;
        }

    /* Styling for completed service text */
    .completed-text {
        color: #28a745;
        font-weight: bold;
        text-align: center;
    }

    /* Card styling for table container */
    .table-card {
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
        padding: 20px;
    }
</style>

<div class="container2">
    <h2 class="page-title">My Confirmed Bids</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            You have no confirmed bids at this time.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Service Category</th>
                        <th>Bid Amount</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bid in Model)
                    {
                        var serviceRequest = bid.ServiceRequest;
                        var serviceCategory = db.ServiceCategories.Find(int.Parse(bid.ServiceRequest.ServiceCategory));

                        <tr>
                            <td>@serviceRequest.Event.Name</td>
                            <td>@serviceCategory.Name</td>
                            <td>R @bid.Price</td>
                            <td>@bid.ServiceRequest.Priority</td>
                            <td>@serviceRequest.Status.ToString()</td>
                            <td>

                                @if (User.IsInRole("ServiceProvider"))
                                {
                                    @*(serviceRequest.IsAssigned && !serviceRequest.IsCompleted) for backwards complatability*@

                                    if (serviceRequest.Status == ServiceRequestStatus.InProgress)
                                    {
                                        <!-- PerfomService Button -->
                                        <a href="@Url.Action("PerformService", "ServiceProvider", new { bidId = bid.Id })" class="confirm-btn btn-warning">PerfomService</a> <span> | </span>
                                        <!-- Confirm Service Button -->
                                        <a href="@Url.Action("ConfirmService", "ServiceProvider", new { bidId = bid.Id })" class="btn btn-danger">Complete Service</a> <span> | </span>

                                    }
                                    else if (serviceRequest.Status == ServiceRequestStatus.UnderInspection)
                                    {
                                        <!-- Service Completed Label -->
                                        <span style="color:purple;" class="badge badge-warning p-4">Service Under Inspection</span>
                                    }
                                    else if (serviceRequest.Status == ServiceRequestStatus.Completed)
                                    {
                                        <!-- Service Completed Label -->
                                        <span style="color:lawngreen;" class="badge badge-success p-4">Service Completed</span>
                                    }
                                    else if (serviceRequest.Status == ServiceRequestStatus.Cancelled)
                                    {
                                        <!-- Service Completed Label -->
                                        <span style="color:red;" class="badge badge-success">Service Cancelled</span>
                                    }
                                    else if (serviceRequest.Status == ServiceRequestStatus.Assigned || (serviceRequest.IsAssigned && !serviceRequest.IsCompleted))
                                    {
                                        <!-- Start Service Button -->
                                        <a href="@Url.Action("StartService", "ServiceProvider", new { bidId = bid.Id })" class="btn btn-success">Start Service</a>
                                    }

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }</div>


