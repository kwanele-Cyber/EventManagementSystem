@model EventMangementSystem.Models.ServiceRequest

@{
    ViewBag.Title = "Display QR Code and Start Code";
}

<h2>QR Code and 4-Digit Pin for Service Verification</h2>

<div class="container">
    <div class="alert alert-info" role="alert">
        Please provide the following QR code or 4-digit pin to the ServiceProvider for verification and starting the service.
    </div>

    <!-- Display the QR Code -->
    <div class="row">
        <div class="col-md-6">
            <h4>QR Code:</h4>
            <img src="data:image/png;base64,@Model.FinishQRCode" alt="Start QR Code" class="img-fluid" />
            <p>The ServiceProvider can scan this QR code to start the service.</p>
        </div>

        <!-- Display the 4-digit pin -->
        <div class="col-md-6">
            <h4>4-Digit Start Code:</h4>
            <div class="alert alert-info" role="alert">
                <strong>@Model.StartCode</strong>
            </div>
            <p>Provide this pin to the ServiceProvider to manually start the service if needed.</p>
        </div>
    </div>

    <!-- Back Button -->
    <div class="row mt-3">
        <div class="col-md-12">
            <a href="@Url.Action("Index", "EventManager")" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>
</div>
