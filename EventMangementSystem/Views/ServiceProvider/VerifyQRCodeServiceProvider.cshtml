@model EventMangementSystem.Models.ServiceRequest

<script src="~/Scripts/html5-qrcode.min.js"></script>
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<h2 class="page-title">Start the Service by Verifying the QR Code or Start Code</h2>

<div class="container">
    <div class="alert alert-info" role="alert">
        Please scan the QR code or enter the 4-digit pin to verify and start the service.
    </div>

    <!-- QR Code Input Form -->
    <div class="row">
        <div class="col-md-6">
            <h4>Enter the Start Code Manually:</h4>

            @using (Html.BeginForm("VerifyQRCode", "ServiceProvider", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="enteredCode">Enter 4-Digit Pin:</label>
                    <input type="text" id="enteredCode" name="enteredCode" class="form-control" placeholder="Enter Start Code" required />
                </div>

                <div class="form-group">
                    <input type="hidden" name="bidId" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Submit Code</button>
                </div>
            }
        </div>

        <!-- QR Code Scanner Integration -->
        <div class="col-md-6">
            <h4>Scan the QR Code:</h4>

            <!-- QR code scanner container -->
            <div id="qr-code-scanner" style="width:100%;"></div>
        </div>
    </div>

    <!-- Back Button -->
    <div class="row mt-3">
        <div class="col-md-12">
            <a href="@Url.Action("ConfirmedBids", "ServiceProvider")" class="btn btn-secondary">Back to My Bids</a>
        </div>
    </div>
</div>

<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 3rem;
        color: #343a40;
    }

    #qr-code-scanner {
        width: 100%;
        height: 250px;
        border: 1px solid #ddd;
        margin-top: 15px;
    }
</style>

<script>
    // QR Code Scanner configuration
    const html5QrCodeScanner = new Html5QrcodeScanner("qr-code-scanner", {
        formatsToSupport: [Html5QrcodeSupportedFormats.QR_CODE],
        fps: 10,
        qrbox: 250
    });

    html5QrCodeScanner.render(onScanSuccess, onScanFailure);

    function onScanSuccess(qrCodeMessage) {
        // Automatically submit the scanned QR code for verification
        sendCodeToServer(qrCodeMessage);
        html5QrCodeScanner.clear();
    }

    function onScanFailure(error) {
        console.error("QR code scanning failed:", error);
    }

    // Sends the scanned or manually entered code to the server
    function sendCodeToServer(code) {
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("VerifyQRCode", "ServiceProvider")';
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'enteredCode';
        input.value = code;
        form.appendChild(input);
        var bidIdInput = document.createElement('input');
        bidIdInput.type = 'hidden';
        bidIdInput.name = 'bidId';
        bidIdInput.value = '@Model.Id';
        form.appendChild(bidIdInput);
        document.body.appendChild(form);
        form.submit();
    }
</script>
