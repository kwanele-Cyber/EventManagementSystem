@model EventMangementSystem.Models.Quotation
@using EventMangementSystem.Models
@{
    ApplicationDbContext db = new ApplicationDbContext();
}

<h2 class="page-title">Submit a Bid for Service Request</h2>

<div class="container">
    @using (Html.BeginForm("SubmitBid", "ServiceProvider", FormMethod.Post, new { @class = "form-horizontal" }))
    {
       
        @Html.AntiForgeryToken()
      
    <div class="form-group">
        @{ var Serv = db.ServiceRequests.Find(Model.ServiceRequestId);
            var sevCat = db.ServiceCategories.Find(int.Parse(Serv.ServiceCategory));}
        <label>Service Request :</label>
        <span>@sevCat.Name</span>

        @Html.HiddenFor(m => m.ServiceRequestId)
        @Html.HiddenFor(m => m.ServiceProviderId)
    </div>

        <div class="form-group">
            <label>Amount</label>
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", placeholder = "Enter your bid amount" })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Description</label>
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Describe your services" })
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <input type="submit" value="Submit Bid" class="btn btn-primary" />
        </div>
    }
</div>
<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 2.5rem;
        color: #343a40;
    }
</style>