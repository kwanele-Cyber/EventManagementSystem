@model EventMangementSystem.Models.ServiceProviderDashboardViewModel
@{
    ViewBag.Title = "Service Provider Dashboard";
}

<style>
    /* Dashboard styling */
    .dashboard-container {
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 10px;
    }

    h2 {
        color: #333;
        text-align: center;
        font-family: 'Arial', sans-serif;
    }

    .summary-section {
        display: flex;
        justify-content: space-around;
        margin-bottom: 20px;
    }

    .summary-card {
        background-color: white;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
        width: 30%;
        text-align: center;
    }

    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        .table th {
            background-color: #007bff;
            color: white;
        }

        .table tr:hover {
            background-color: #f1f1f1;
        }

    .analytics-chart {
        width: 100%;
        height: 300px;
        margin-top: 20px;
    }
</style>

<div class="dashboard-container">
    <h2>Service Provider Dashboard</h2>

    <div class="summary-section">
        <div class="summary-card">
            <h3>Total Earnings</h3>
            <p>R @Model.TotalEarnings</p>
        </div>
        <div class="summary-card">
            <h3>Upcoming Bookings</h3>
            <p>@Model.UpcomingBookingsCount</p>
        </div>

    </div>

    <h3>Upcoming Bookings</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date & Time</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.UpcomingBookings)
            {
                <tr>
                    <td>@booking.EventName</td>
                    <td>@booking.EventDateTime.ToString("g")</td>
                    <td>@booking.Status</td>
                    <td>
                        <a href="@Url.Action("ViewBooking", "ServiceProvider", new { id = booking.Id })" class="btn btn-info">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Recent Reviews</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Rating</th>
                <th>Comment</th>
            </tr>
        </thead>
    </table>

    <h3>Performance Analytics</h3>
    <div class="analytics-chart">
        <canvas id="revenueChart"></canvas>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<canvas id="revenueChart" width="400" height="200"></canvas>
<script>
const ctx = document.getElementById('revenueChart').getContext('2d');
const revenueChart = new Chart(ctx, {
    type: 'bar',  // Type set to 'bar'
    data: {
        labels: @Html.Raw(Json.Encode(Model.RevenueLabels)),  // Ensure this is an array of labels for each transaction
        datasets: [{
            label: 'Revenue from Transactions',
            data: @Html.Raw(Json.Encode(Model.RevenueData)),  // Ensure this matches the number of labels
            backgroundColor: 'rgba(75, 192, 192, 0.5)',  // Bar color
            borderColor: 'rgba(75, 192, 192, 1)',  // Border color for bars
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        scales: {
            y: {
                beginAtZero: true  // Starts the y-axis at 0
            }
        }
    }
});
</script>
</div>
