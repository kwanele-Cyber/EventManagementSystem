@model IEnumerable<EventMangementSystem.Models.Quotation>

@{
   
}

<h2 class="page-title">My Bids</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Service Request</th>
            <th>Event</th>
            <th>Bid Amount</th>
            <th>Description</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bid in Model)
        {
            <tr>
                <td>@bid.ServiceRequest.ServiceCategory</td>
                <td>@bid.ServiceRequest.Event.Name</td>
                <td>@bid.Price.ToString("R,00")</td>
                <td>@bid.Description</td>
                <td>@(bid.ServiceRequest.IsAssigned ? "Assigned" : "Pending")</td>
            </tr>
        }
    </tbody>
</table>
<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 2.5rem;
        color: #343a40;
    }
</style>