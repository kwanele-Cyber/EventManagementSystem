@model EventMangementSystem.ViewModels.TeamEmployeeViewModel

@{
    ViewBag.Title = "Coordinate Team";
}

<h2>Coordinate Team</h2>

<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item active">
        <a class="nav-link active" href="#createTeam" role="tab" data-toggle="tab">Create Team</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#addEmployee" role="tab" data-toggle="tab">Add Employee</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#assignRoles" role="tab" data-toggle="tab">Assign Roles</a>
    </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
    <!-- Create Team tab -->
    <div role="tabpanel" class="tab-pane active" id="createTeam">
        <div class="form-horizontal">
            @using (Html.BeginForm("CreateTeam", "Teams", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <h4>Create Team</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(model => model.Team.TeamName, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Team.TeamName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Team.TeamName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Team.Description, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.Team.Description, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Team.Description, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Employees", "Select Employees", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.ListBoxFor(m => m.SelectedEmployeeIds, new MultiSelectList(Model.Employees, "EmployeeId", "Name"), new { @class = "form-control", multiple = "multiple" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Add Employee tab -->
    <div role="tabpanel" class="tab-pane" id="addEmployee">
        <div class="form-horizontal">
            @using (Html.BeginForm("Create", "Employees", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <h4>Add Employee</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.Label("Employee Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Email", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Role", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <input type="text" name="Position" class="form-control" placeholder="e.g., Technician, Supervisor" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Add Employee" class="btn btn-success" />
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Assign Roles tab -->
    <div role="tabpanel" class="tab-pane" id="assignRoles">
        <div class="form-horizontal">
            @using (Html.BeginForm("AssignRoles", "Teams", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <h4>Assign Roles to Team Members</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @* Here, we correct the Razor syntax for the 'for' loop *@

                if (Model.Team.TeamMembers != null)
                {
                    List<EventMangementSystem.Models.TeamMember> items = Model.Team.TeamMembers.ToList();

                    for (int i = 0; i < items.Count; i++)
                    {
                        <div class="form-group">
                            @Html.Label(items[i].Employee.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.TextBoxFor(m => m.Team.TeamMembers.ToList()[i].Role, new { @class = "form-control", placeholder = $"Role for {items[i].Employee.Name}" })
                                @Html.ValidationMessageFor(m => m.Team.TeamMembers.ToList()[i].Role, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    }
                }
                else if (Model.Team.TeamMembers == null)
                {
                    <div class="form-group">
                        <h2 class="h2 text-bg-info">No Members Have been Added in this Team</h2>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Save Roles" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Scripts for enabling tab navigation -->
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            // Activate the first tab by default
            $('.nav-tabs a[href="#createTeam"]').tab('show');
        });
    </script>
}
