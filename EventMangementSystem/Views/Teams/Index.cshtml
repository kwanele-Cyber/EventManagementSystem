@model IEnumerable<EventMangementSystem.Models.Team>

@{
    var email = ViewBag.Email;
    var myGroupRole = "";
}

<h2 class="page-title">Team List</h2>
<div>

</div>
<p>@email</p>

<table class="table">
    <tr>
        <th>Team Name</th>
        <th>Description</th>
        <th>Members</th>
        <th></th>
    </tr>
    @if (User.IsInRole("Employee"))
    {
        foreach (var item in Model)
        {

            foreach (var member in item.TeamMembers)
            {
                if (member.Employee.Email == email)
                {
                    <tr>
                        <td>@item.TeamName</td>
                        <td>@item.Description</td>
                        <td>
                            <span>@member.Employee.Name (@member.Employee.Email)</span><br />
                        </td>
                        <td>
                            @{
                                if (member.HasAccepted == false)
                                {
                                    <span> @Html.ActionLink("Accept", "Accept", new { memberId = member.TeamMemberId ,id = item.TeamId }) </span>
                                }
                                else if (myGroupRole == "Leader")
                                {
                                    <span> @Html.ActionLink("Edit", "Edit", new { id = item.TeamId }) </span>
                                }<span> |</span>
                                @Html.ActionLink("Details", "Details", new { id = item.TeamId }) <span> |</span>
                                @Html.ActionLink("Delete", "Delete", new { id = item.TeamId })
                            }
                        </td>
                    </tr>
                }
            }
        }
    }
    else if (User.IsInRole("Admin"))
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.TeamName</td>
                <td>@item.Description</td>
                <td>
                    @foreach (var member in item.TeamMembers)
                    {
                        <span>@member.Employee.Name (@member.Employee.Email)</span><br />
                    }
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.TeamId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.TeamId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.TeamId })
                </td>
            </tr>
        }
    }
    else if (User.IsInRole("ServiceProvider"))
    {
        foreach (var item in Model)
        {
            @*
            if (item.ServiceProvider.email == email)
            {
                <tr>
                    <td>@item.TeamName</td>
                    <td>@item.Description</td>
                    <td>
                        @foreach (var member in item.TeamMembers)
                        {
                            <span>@member.Employee.Name (@member.Employee.Email)</span><br />
                        }
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.TeamId }) |
                        @Html.ActionLink("Details", "Details", new { id = item.TeamId }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.TeamId })
                    </td>
                </tr>
            }
           *@

                <tr>
                    <td>@item.TeamName</td>
                    <td>@item.Description</td>
                    <td>
                        @foreach (var member in item.TeamMembers)
                        {
                            <span>@member.Employee.Name (@member.Employee.Email)</span><br />
                        }
                    </td>
                    <td>
                        @if (item.ServiceProviderId == null)
                        {
                            @Html.ActionLink("Assign Service Request", "AssignServiceRequest", new { teamId = item.TeamId, returnUrl = Request.Url.AbsoluteUri }, new { @class = "btn btn-primary" })
                        }
                        |
                        @Html.ActionLink("Edit", "Edit", new { id = item.TeamId }) |
                        @Html.ActionLink("Details", "Details", new { id = item.TeamId }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.TeamId })
                    </td>
                </tr>
        }
    }
</table>
@if (User.IsInRole("ServiceProvider"))
{
<p>
    @Html.ActionLink("Create New Team", "CreateTeam")
</p>
}
<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 3rem;
        color: #343a40;
    }
</style>