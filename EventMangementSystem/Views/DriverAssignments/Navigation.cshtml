
<style>
    #map {
        height: 400px;
        width: 100%;
    }

    #directions-panel {
        margin-top: 20px;
    }
</style>

<section class="w3l-index-about py-5" id="about2">
    <div class="container py-md-5 py-2">
        <h2>Navigation</h2>
        <div id="map"></div>
        <div id="directions-panel"></div>
        <a href="@Url.Action("FinishInventoryDelivery","DriverAssignments")" class="btn btn-warning" data-abc="true"> Complete Delivery</a>
    </div>
</section>
<script>
    var map;
    var directionsService;
    var directionsRenderer;
    var carMarker;

    function initMap() {
        // Initialize the map
        map = new google.maps.Map(document.getElementById('map'), {
            zoom: 8,
            center: { lat: -34.397, lng: 150.644 } // Default center, can be customized
        });

        directionsService = new google.maps.DirectionsService();
        directionsRenderer = new google.maps.DirectionsRenderer({
            map: map,
            panel: document.getElementById('directions-panel') // Display route steps in this panel
        });

        // Get user's current location
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    var userLocation = {
                        lat: position.coords.latitude,
                        lng: position.coords.longitude
                    };

                    // Fetch destination address from ViewBag
                    var destinationAddress = '@ViewBag.DestinationAddress';

                    // Calculate route between user's location and destination
                    calculateAndDisplayRoute(userLocation, destinationAddress);
                },
                function () {
                    handleLocationError(true, map.getCenter());
                }
            );
        } else {
            // Browser doesn't support Geolocation
            handleLocationError(false, map.getCenter());
        }
    }

    function calculateAndDisplayRoute(origin, destination) {
        var request = {
            origin: origin,
            destination: destination,
            travelMode: google.maps.TravelMode.DRIVING
        };

        directionsService.route(request, function (response, status) {
            if (status === google.maps.DirectionsStatus.OK) {
                directionsRenderer.setDirections(response);
                // Start updating car icon position
                updateCarPosition(response.routes[0].legs[0].steps, 0);
            } else {
                console.error('Error calculating directions:', status);
                alert('Could not display directions due to: ' + status);
            }
        });
    }

    function updateCarPosition(steps, stepIndex) {
        var step = steps[stepIndex];
        var stepPath = step.path;
        var carIndex = 0;

        if (!carMarker) {
            carMarker = new google.maps.Marker({
                map: map,
                icon: {
                    url: 'car-icon.png', // Replace with the path to your car icon
                    scaledSize: new google.maps.Size(50, 50) // Adjust the size of the icon
                }
            });
        }

        var intervalId = setInterval(function () {
            carIndex++;
            if (carIndex >= stepPath.length) {
                if (stepIndex + 1 < steps.length) {
                    stepIndex++;
                    step = steps[stepIndex];
                    stepPath = step.path;
                    carIndex = 0;
                } else {
                    clearInterval(intervalId); // Stop updating when end of route is reached
                    return;
                }
            }
            carMarker.setPosition(stepPath[carIndex]);
        }, 1000); // Update car position every 1 second (adjust as needed)
    }

    function handleLocationError(browserHasGeolocation, pos) {
        var errorMsg = browserHasGeolocation ?
            "Error: The Geolocation service failed." :
            "Error: Your browser doesn't support geolocation.";
        alert(errorMsg);
        map.setCenter(pos);
    }
</script>

<!-- Include Google Maps API script with the callback parameter -->
<script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB3XCyomDrTWDizZVAXAX3F89KUa5ITw6E&callback=initMap&callback=initMap"></script>

