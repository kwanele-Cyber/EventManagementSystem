@model IEnumerable<EventMangementSystem.Models.EventInventory>

@{

}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2 class="page-title">Event Inventory List</h2>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header text-center bg-primary text-white rounded-top">
                        <h5 class="card-title m-0">@item.Event.Name</h5>
                    </div>
                    <div class="card-body p-3">
                        <table class="table table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <th class="text-right pr-2" style="width: 50%;">Inventory ID:</th>
                                    <td>@item.InventoryId</td>
                                </tr>
                                <tr>
                                    <th class="text-right pr-2">Quantity Required:</th>
                                    <td>@item.QuantityRequired</td>
                                </tr>
                                <tr>
                                    <th class="text-right pr-2">Unique Code:</th>
                                    <td>@item.UniqueCode</td>
                                </tr>
                                @if (item.DeliveredBy > 0)
                                {
                                    <tr>
                                        <th class="text-right pr-2">Driver Signature:</th>
                                        <td>
                                            <button class="btn btn-sm btn-light" data-toggle="modal" data-target="#driverSignatureModal-@item.EventInventoryId">
                                                <i class="fa fa-eye"></i> View
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-right pr-2">Admin Signature:</th>
                                        <td>
                                            <button class="btn btn-sm btn-light" data-toggle="modal" data-target="#adminSignatureModal-@item.EventInventoryId">
                                                <i class="fa fa-eye"></i> View
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-right pr-2">QR Code Picture:</th>
                                        <td>
                                            <button class="btn btn-sm btn-light" data-toggle="modal" data-target="#qrCodeModal-@item.EventInventoryId">
                                                <i class="fa fa-eye"></i> View
                                            </button>
                                        </td>
                                    </tr>

                                }

                                <tr>
                                    <th class="text-right pr-2">Status:</th>
                                    <td>@item.Status</td>
                                </tr>
                                <tr>
                                    <th class="text-right pr-2">Email:</th>
                                    <td>@item.Event.EventMangerEmail</td>
                                </tr>
                                <tr>
                                    <th class="text-right pr-2">Address:</th>
                                    <td>@item.Event.Location</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-center bg-light p-2">
                        @*<a href="@Url.Action("Edit", new { id = item.EventInventoryId })" class="btn btn-sm btn-primary mx-1">
                                <i class="fa fa-pencil-alt"></i> Edit
                            </a>
                            <a href="@Url.Action("Details", new { id = item.EventInventoryId })" class="btn btn-sm btn-info mx-1">
                                <i class="fa fa-eye"></i> Details
                            </a>*@
                        @if (item.DeliveredBy > 0)
                        {
                            <a href="#" class="btn btn-sm btn-warning mx-1" data-toggle="modal" data-target="#deliveryModal-@item.EventInventoryId">
                                <i class="fa fa-truck"></i> Delivery Details
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Drivers", new {id = item.EventInventoryId})" class="btn btn-sm btn-warning mx-1">
                                <i class="fa fa-truck"></i> Schedule Delivery
                            </a>
                        }
                        @*<a href="@Url.Action("Delete", new { id = item.EventInventoryId })" class="btn btn-sm btn-danger mx-1" onclick="return confirm('Are you sure you want to delete this item?');">
                                <i class="fa fa-trash"></i> Delete
                            </a>*@
                    </div>
                </div>

                <!-- Delivery Modal -->
                <div class="modal fade" id="deliveryModal-@item.EventInventoryId" tabindex="-1" role="dialog" aria-labelledby="deliveryModalLabel-@item.EventInventoryId" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deliveryModalLabel-@item.EventInventoryId">Delivery Details - @item.Event.Name</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">

                                <table class="table table-bordered">
                                    <tbody>
                                        <tr>
                                            <th>Driver Email</th>
                                            <td>@item.DriverEmail</td>
                                        </tr>
                                        <tr>
                                            <th>First Name</th>
                                            <td>@item.FirstName</td>
                                        </tr>
                                        <tr>
                                            <th>Delivery Time</th>
                                            <td> @DateTime.Now.ToString("HH:mm")</td>
                                        </tr>

                                        <tr>
                                            <th>Delivery Date</th>
                                            <td>@item.Event.Start.ToLongDateString()</td>
                                        </tr>
                                        <tr>
                                            <th>Delivered On</th>
                                            <td>@item.DeliveredOn</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- QR Code Picture Modal -->
                <div class="modal fade" id="qrCodeModal-@item.EventInventoryId" tabindex="-1" role="dialog" aria-labelledby="qrCodeModalLabel-@item.EventInventoryId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="qrCodeModalLabel-@item.EventInventoryId">QR Code - @item.Event.Name</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="~/path-to-qr-code/@item.QrCodePicture" class="img-fluid" alt="QR Code">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Driver Signature Modal -->
                <div class="modal fade" id="driverSignatureModal-@item.EventInventoryId" tabindex="-1" role="dialog" aria-labelledby="driverSignatureModalLabel-@item.EventInventoryId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="driverSignatureModalLabel-@item.EventInventoryId">Driver Signature - @item.Event.Name</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="~/path-to-signature/@item.DriverSignature" class="img-fluid" alt="Driver Signature">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admin Signature Modal -->
                <div class="modal fade" id="adminSignatureModal-@item.EventInventoryId" tabindex="-1" role="dialog" aria-labelledby="adminSignatureModalLabel-@item.EventInventoryId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="adminSignatureModalLabel-@item.EventInventoryId">Admin Signature - @item.Event.Name</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body text-center">
                                <img src="~/path-to-signature/@item.AdminSignature" class="img-fluid" alt="Admin Signature">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">



<style>
    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-family: 'Georgia', serif;
        font-size: 3rem;
        color: #343a40;
    }

    h2.text-primary {
        font-weight: bold;
    }

    .card {
        border-radius: 10px;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: scale(1.03);
        }

    .btn {
        border-radius: 30px;
    }

        .btn i {
            margin-right: 5px;
        }

    .card-header {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .table-borderless th, .table-borderless td {
        padding: 0.3rem;
    }

    .card-footer {
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }
</style>

<!-- Add Bootstrap 4 JS for Modals -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
