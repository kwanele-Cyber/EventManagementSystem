@model IEnumerable<EventMangementSystem.Models.ReturnProcess>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.DriverAssignment.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EventInventory.DriverSignature)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.QuantityReturned)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ReturnSubmittedOn)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.DriverAssignment.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EventInventory.DriverSignature)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.QuantityReturned)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Status)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ReturnSubmittedOn)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ReturnProcessId }) |
            @Html.ActionLink("Details", "Details", new { id=item.ReturnProcessId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.ReturnProcessId })
        </td>
    </tr>
}

</table>
