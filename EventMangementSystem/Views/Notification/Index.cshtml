@model IEnumerable<EventMangementSystem.Models.Notification>

<h2>Your Notifications</h2>

<table class="table">
    <thead>
        <tr>
            <th>Message</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var notification in Model)
        {
            <tr class="@(notification.IsRead ? "" : "font-weight-bold")">
                <td>@notification.Message</td>
                <td>@notification.CreatedAt.ToString("g")</td>
                <td>@(notification.IsRead ? "Read" : "Unread")</td>
                <td>
                    @using (Html.BeginForm("MarkAsRead", "Notification", new { id = notification.NotificationId }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-sm btn-success">Mark as Read</button>
                    }
                    @using (Html.BeginForm("Delete", "Notification", new { id = notification.NotificationId }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
