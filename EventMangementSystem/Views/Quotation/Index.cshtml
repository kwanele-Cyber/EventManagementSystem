@model IEnumerable<EventMangementSystem.Models.Quotation>

<h2>Quotations</h2>

@Html.ActionLink("Submit New Quotation", "Create", new { serviceRequestId = ViewBag.ServiceRequestId }, new { @class = "btn btn-primary" })

<table class="table">
    <thead>
        <tr>
            <th>Amount</th>
            <th>Details</th>
            <th>Status</th>
            <th>Submitted At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quotation in Model)
        {
            <tr>
                <td>@quotation.Amount.ToString("C")</td>
                <td>@quotation.Details</td>
                <td>@quotation.Status</td>
                <td>@quotation.CreatedAt.ToString("g")</td>
                @if (quotation.Status == "Pending")
                {
                    <td>

                        @Html.ActionLink("Approve", "Approve", new { id = quotation.QuotationId }, new { @class = "btn btn-success btn-sm" }) |
                        @Html.ActionLink("Reject", "Reject", new { id = quotation.QuotationId }, new { @class = "btn btn-danger btn-sm" })


                    </td>
                }
                <td>
                    @Html.ActionLink("Details", "Details", new { id = quotation.QuotationId }, new { @class = "btn btn-info btn-sm" })

                </td>
            </tr>
        }
    </tbody>
</table>
