@model IEnumerable<EventMangementSystem.Models.ServiceRequest>
@{
    ViewBag.Title = "Service Requests";
}

<h2>Service Requests</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Service Name</th>
            <th>Event</th>
            <th>Team</th>
            <th>Service Provider</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var request in Model)
            {
                <tr>
                    <td>@request.Id</td>
                    <td>@request.ServiceName</td>
                    <td>@request.Event.Name</td>
                    <td>@request.Team?.TeamName ?? "Not Assigned"</td>
                    <td>@request.ServiceProvider?.Name ?? "Not Assigned"</td>
                    <td>@request.Status</td>
                    <td>
                        @Html.ActionLink("Details", "Details", new { id = request.Id }, new { @class = "btn btn-info" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No service requests found</td>
            </tr>
        }
    </tbody>
</table>

